generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FarmerIdType {
  AADHAAR
  PAN
  DRIVING_LICENSE
}

enum Role {
  FARMER
  MANDI_OPERATOR
  ADMIN
}

enum OtpType {
  EMAIL_VERIFICATION
  LOGIN_OTP
  PASSWORD_RESET
}

enum BookingStatus {
  PENDING
  ACCEPTED
  REJECTED
  ARRIVED
  VERIFIED
  COMPLETED
  CANCELLED
}

enum MandiApprovalStatus {
  PENDING_ONBOARDING
  PENDING_APPROVAL
  APPROVED
  REJECTED
  REQUIRES_DOCUMENTS
}

enum LegalDocType {
  MANDI_LICENSE
  APMC_REGISTRATION
  GST_CERTIFICATE
  OTHER
}

enum DocVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

model User {
  id                  String               @id @default(cuid())
  name                String
  email               String               @unique
  phone               String?              @unique
  passwordHash        String
  role                Role                 @default(FARMER)
  isVerified          Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  refreshTokens       RefreshToken[]
  otps                OtpVerification[]
  passwordResetTokens PasswordResetToken[]
  farmerProfile       FarmerProfile?

  // Relations for Mandi & Farmer operations
  mandiProfile        MandiProfile?
  farmerBookings      Booking[]            @relation("FarmerBookings")

  @@index([email])
  @@index([phone])
  @@index([role])
}

model FarmerProfile {
  id                 String          @id @default(cuid())
  userId             String          @unique
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Formatted Sequential Farmer ID (e.g. FAR001, FAR002)
  farmerCode         String?         @unique

  // Personal & KYC Identity Information
  dob                String?         // YYYY-MM-DD
  address            String?         // Full Address
  idType             FarmerIdType?   // AADHAAR, PAN, DRIVING_LICENSE
  idNumber           String?
  avatarUrl          String?
  isProfileComplete  Boolean         @default(false)

  // Detailed Address Fields
  addressLine1       String?
  addressLine2       String?
  village            String?
  taluka             String?
  district           String?
  state              String?
  pincode            String?
  
  // Farm & Agriculture Details
  landSizeAcres      Float?
  mainCrops          String[]        @default([])
  secondaryCrops     String[]        @default([])
  irrigationType     String?         // e.g., Drip, Sprinkler, Well, Canal, Rainfed
  farmLocation       String?         // GPS / Coordinates or Landmark
  
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([userId])
  @@index([farmerCode])
  @@index([district, state])
  @@index([pincode])
  @@index([isProfileComplete])
}

model RefreshToken {
  id                  String    @id @default(cuid())
  tokenHash           String    @unique
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt           DateTime
  revokedAt           DateTime?
  replacedByTokenHash String?
  createdAt           DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
}

model OtpVerification {
  id          String    @id @default(cuid())
  identifier  String    // Email address or phone number
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash    String
  type        OtpType
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([identifier, type])
  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
}

model MandiProfile {
  id                  String               @id @default(cuid())
  userId              String               @unique
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  mandiName           String?
  mandiCode           String?              @unique // Sequential code e.g. MAN001, MAN002
  apmcCode            String?              @unique
  address             String?
  pincode             String?
  district            String?
  state               String?
  operatingHours      String?              @default("08:00 AM - 06:00 PM (Mon-Sat)")
  closedDays          String[]             @default([]) // e.g. ["Sunday"]
  closedHours         String?              // e.g. "13:00 - 14:00 Lunch break"
  isLocationSet       Boolean              @default(false)
  
  // Real-time Geo Coordinates & APMC Auction Metrics
  latitude            Float?
  longitude           Float?
  topCrop             String?              // e.g. "Onion (Red) & Grapes"
  acceptedCrops       String[]             @default([]) // Official commodities accepted at this mandi
  modalPrice          String?              // e.g. "₹2,680 / qtl"
  priceTrend          String?              // e.g. "+₹120 today"
  trendDirection      String?              @default("up")
  estimatedQueueTime  String?              @default("20 mins wait")
  activeFarmersCount  Int                  @default(85)
  isOpen              Boolean              @default(true)

  aadhaarNumber       String?
  aadhaarVerified     Boolean              @default(false)
  aadhaarDocUrl       String?
  avatarUrl           String?
  approvalStatus      MandiApprovalStatus  @default(PENDING_ONBOARDING)
  rejectionReason     String?
  approvedAt          DateTime?
  rating              Float                @default(4.8)
  totalReviews        Int                  @default(0)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  slots               MandiSlot[]
  bookings            Booking[]
  legalDocs           MandiLegalDoc[]

  @@index([userId])
  @@index([mandiCode])
  @@index([apmcCode])
  @@index([approvalStatus])
  @@index([district, state])
}

model Commodity {
  id          String   @id @default(cuid())
  name        String   @unique
  category    String?  // e.g. "Cereals", "Pulses", "Vegetables", "Fruits", "Oilseeds", "Spices", "Cash Crops"
  defaultUnit String   @default("kg")
  createdAt   DateTime @default(now())

  @@index([name])
}

model MandiSlot {
  id                     String       @id @default(cuid())
  mandiProfileId         String
  mandiProfile           MandiProfile @relation(fields: [mandiProfileId], references: [id], onDelete: Cascade)
  crop                   String
  allowedCrops           Json?        // Multi-crop: [{ crop: string, quantityKg?: number, ratePerKg?: number, isFixed?: boolean }]
  instructions           String?      // Gate arrival / intake instructions for farmers
  date                   String       // Format: YYYY-MM-DD
  startTime              String       // Format: HH:mm
  endTime                String       // Format: HH:mm
  totalCapacityQuintals  Float
  totalCapacityKg        Float?       // Intake capacity in KG
  bookedCapacityQuintals Float        @default(0)
  bookedCapacityKg       Float?       @default(0)
  capacityPercentage     Float        @default(0)
  maxFarmers             Int
  bookedFarmers          Int          @default(0)
  availableBookings      Int
  bufferMinutes          Int          @default(15)
  bufferPercentage       Float        @default(10)
  isActive               Boolean      @default(true)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  bookings               Booking[]

  @@index([mandiProfileId])
  @@index([date, crop])
  @@index([isActive])
}

model Booking {
  id                 String        @id @default(cuid())
  token              String        @unique // e.g. 4MAY-10AM-001 or TKN-7821
  queueNumber        Int           @default(1) // Queue sequence number per slot (e.g. 1 for 001)
  farmerId           String
  farmer             User          @relation("FarmerBookings", fields: [farmerId], references: [id], onDelete: Cascade)
  mandiProfileId     String
  mandiProfile       MandiProfile  @relation(fields: [mandiProfileId], references: [id], onDelete: Cascade)
  slotId             String
  slot               MandiSlot     @relation(fields: [slotId], references: [id], onDelete: Cascade)
  crop               String
  variety            String?
  cropsList          Json?         // Multi-crop breakdown: [{ crop: string, quantityKg: number, ratePerKg: number, estimatedAmount: number }]
  quantityQuintals   Float
  quantityKg         Float?        // Explicit quantity in KG
  capacityPercentage Float         @default(0)
  vehicleNumber      String?
  qrCodeData         String?
  status             BookingStatus @default(PENDING)
  notes              String?
  rejectionReason    String?       // Stored reason when rejected by Mandi operator
  estimatedPayout    Float?        // Total estimated payout amount based on crop rates
  verifiedAt         DateTime?
  servedAt           DateTime?
  completedAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([farmerId])
  @@index([mandiProfileId])
  @@index([slotId])
  @@index([token])
  @@index([status])
}

model MandiLegalDoc {
  id             String                @id @default(cuid())
  mandiProfileId String
  mandiProfile   MandiProfile          @relation(fields: [mandiProfileId], references: [id], onDelete: Cascade)
  name           String
  type           LegalDocType          @default(MANDI_LICENSE)
  status         DocVerificationStatus @default(PENDING)
  fileUrl        String?
  uploadedAt     DateTime              @default(now())

  @@index([mandiProfileId])
}
